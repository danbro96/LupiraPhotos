# The member API and auth are same-origin via the BFF — the SPA calls /photo-api, /api and /auth
# directly, so there is normally nothing to set here.

# Sibling apps the photo screens link out to. Dev defaults to their Vite ports (5174/5175/5176),
# production to https://{cal,maps,photos}.lupira.com.
# VITE_CAL_URL=http://localhost:5174
# VITE_MAPS_URL=http://localhost:5175
# VITE_PHOTOS_URL=http://localhost:5176

# Local dev: the Vite dev server proxies /api, /auth, … to the BFF. Override its origin if not :5183.
# BACKEND_ORIGIN=http://localhost:5183
